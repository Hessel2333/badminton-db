{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hessel2333.github.io/badminton-db/schemas/product.schema.json",
  "title": "BadmintonDB product",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "brandId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "racket",
        "shuttlecock",
        "shoes",
        "other"
      ]
    },
    "names": {
      "type": "object",
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "zh-CN",
        "en"
      ],
      "additionalProperties": false
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "series": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variant": {
      "type": "object",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "generation",
        "color"
      ],
      "additionalProperties": false
    },
    "specifications": {
      "type": "object",
      "properties": {
        "weightClass": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "gripSize": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseYear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "weightClass",
        "gripSize",
        "releaseYear"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "object",
      "properties": {
        "variantOf": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "variantOf"
      ],
      "additionalProperties": false
    },
    "mediaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "fieldSources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        }
      },
      "required": [
        "sourceIds",
        "verification",
        "fieldSources"
      ],
      "additionalProperties": false
    },
    "curation": {
      "type": "object",
      "properties": {
        "listed": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "listed",
        "tags"
      ],
      "additionalProperties": false
    },
    "priceObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "legacy-reference"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "region": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "amount",
          "currency",
          "region",
          "observedAt",
          "verification",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "legacy": {
      "type": "object",
      "properties": {
        "imageKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "popularity": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "imageKey",
        "popularity",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "slug",
    "brandId",
    "category",
    "names",
    "model",
    "series",
    "aliases",
    "variant",
    "specifications",
    "relations",
    "mediaIds",
    "provenance",
    "curation",
    "priceObservations",
    "legacy",
    "revision"
  ],
  "additionalProperties": false
}
