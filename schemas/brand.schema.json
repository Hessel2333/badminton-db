{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hessel2333.github.io/badminton-db/schemas/brand.schema.json",
  "title": "BadmintonDB brand",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "website": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "verification": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "fieldSources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        }
      },
      "required": [
        "sourceIds",
        "verification",
        "fieldSources"
      ],
      "additionalProperties": false
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "readOnly": true
    }
  },
  "required": [
    "id",
    "name",
    "aliases",
    "website",
    "provenance"
  ],
  "additionalProperties": false
}
