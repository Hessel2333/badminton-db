{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hessel2333.github.io/badminton-db/schemas/asset.schema.json",
  "title": "BadmintonDB asset",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "kind": {
      "enum": [
        "photo",
        "processed-image",
        "generated-render",
        "illustration"
      ]
    },
    "role": {
      "enum": [
        "primary",
        "alternate",
        "detail"
      ]
    },
    "fileName": {
      "type": "string",
      "minLength": 1
    },
    "legacyImageKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "dimensions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hasAlpha": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "isOfficial": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileName": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "reported-official-reference",
                  "unknown-origin"
                ]
              }
            },
            "required": [
              "fileName",
              "sha256",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sourceIds",
        "method",
        "derivedFrom"
      ],
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "approved",
            "restricted"
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "holder": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "license",
        "holder",
        "evidenceUrl"
      ],
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "withheld",
            "public"
          ]
        },
        "file": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^media/files/[a-z0-9][a-z0-9._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "file"
      ],
      "additionalProperties": false
    },
    "syntheticIdentifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "const": "illustrative-only"
          }
        },
        "required": [
          "value",
          "format",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downloadUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ],
      "readOnly": true
    }
  },
  "required": [
    "id",
    "productIds",
    "kind",
    "role",
    "fileName",
    "legacyImageKeys",
    "dimensions",
    "sha256",
    "hasAlpha",
    "isOfficial",
    "provenance",
    "rights",
    "distribution",
    "syntheticIdentifiers",
    "notes"
  ],
  "additionalProperties": false
}
